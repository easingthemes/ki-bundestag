{
  "name": "ki-bundestag",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.6.1",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev:api": "turbo run dev --filter=@ki-bundestag/api",
    "dev:web": "turbo run dev --filter=@ki-bundestag/web",
    "typecheck": "turbo run typecheck",
    "seed": "tsx packages/engine/src/seed.ts",
    "migrate": "tsx packages/engine/src/migrate.ts",
    "simulate": "tsx packages/engine/src/runner.ts",
    "simulate:3": "npm run simulate 3",
    "simulate:6": "npm run simulate 6",
    "simulate:auto": "tsx packages/engine/src/runner-auto.ts",
    "trigger:election": "tsx packages/engine/src/trigger-election.ts",
    "simulate:visitors": "tsx scripts/simulate-visitors.ts",
    "migrate:timing": "tsx scripts/migrate-timing.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:model": "vitest run packages/engine/src/agent/client.test.ts packages/engine/src/agent/batch-client-e2e.test.ts packages/engine/src/agent/briefing.test.ts",
    "seed:demo-users": "tsx scripts/seed-demo-users.ts",
    "bot:activity": "tsx scripts/run-bot-activity.ts",
    "bot:status": "tsx scripts/bot-status.ts",
    "bot:on": "tsx scripts/bot-toggle.ts on",
    "bot:off": "tsx scripts/bot-toggle.ts off",
    "bot:toggle": "tsx scripts/bot-toggle.ts",
    "backfill:summaries": "tsx scripts/backfill-day-summaries.ts",
    "rollback": "tsx scripts/rollback-to-day.ts",
    "kill": "lsof -ti :3001 | xargs kill -9 2>/dev/null; lsof -ti :5173 | xargs kill -9 2>/dev/null; echo 'Killed servers on ports 3001 and 5173'"
  },
  "overrides": {
    "path-to-regexp@<0.1.13": "0.1.13",
    "picomatch@>=4.0.0 <4.0.4": "4.0.4",
    "rollup@>=4.0.0 <4.58.1": "4.60.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^5.2.0",
    "playwright": "^1.58.2",
    "prettier": "^3.8.1",
    "tsx": "^4.19.0",
    "turbo": "^2.4.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.57.2",
    "vitest": "^4.1.2"
  }
}
