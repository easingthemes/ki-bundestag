# Extra sites from other projects on this server (e.g. kai-hausmeister n8n).
# Each project deploys its own file into /etc/caddy/sites/. Empty folder is fine.
import /etc/caddy/sites/*.caddy

{$SITE_ADDRESS:localhost} {
    root * /opt/ki-bundestag/packages/web/dist

    handle /api/* {
        reverse_proxy localhost:3001
    }

    handle /socket.io/* {
        reverse_proxy localhost:3001
    }

    handle {
        try_files {path} /index.html
        file_server
    }
}
