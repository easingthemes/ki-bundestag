{
  "name": "@ki-bundestag/engine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "seed": "tsx src/seed.ts",
    "simulate": "tsx src/runner.ts",
    "simulate:auto": "tsx src/runner-auto.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@ki-bundestag/types": "*",
    "better-sqlite3": "^11.8.0",
    "dotenv": "^16.4.0",
    "drizzle-orm": "^0.39.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.0",
    "drizzle-kit": "^0.30.0"
  }
}
