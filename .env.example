ANTHROPIC_API_KEY=sk-ant-xxxxx
XAI_API_KEY=xai-xxxx

# Database and API config (optional)
DATABASE_PATH=./data/simulation.db
USER_DATABASE_PATH=./data/users.db
API_PORT=3001

# OAuth authentication
# Google: Create credentials at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GOOGLE_CALLBACK_URL=https://yourdomain.com/api/auth/google/callback

# GitHub: Create OAuth app at https://github.com/settings/developers
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# GITHUB_CALLBACK_URL=https://yourdomain.com/api/auth/github/callback

# Session secret (generate a random string for production)
SESSION_SECRET=change-me-in-production

# Frontend URL (for CORS and OAuth redirects)
# FRONTEND_URL=https://yourdomain.com

# Bot activity (automated user simulation)
# BOT_INTERVAL_MS=14400000     # Bot tick interval in ms (default: 4 hours)
# Toggle bots on/off via: npm run bot:on / npm run bot:off (persisted in DB)

# Batch API tuning (async processing, 50% cost savings)
BATCH_POLL_INTERVAL=30    # Seconds between batch status checks
BATCH_TIMEOUT=3600        # Max seconds to wait for batch completion

# Parliamentary calendar (Cycle 1 / todo 043)
# When "false", every day is treated as a plenum-eligible Sitzungstag.
# Used by tests and CI runs that need deterministic daily advancement.
# Default (unset): calendar gating is enforced — Sitzungswochen, Sommerpause,
# Weihnachtspause, and weekday window (Tue–Fri) apply to plenary events.
# CALENDAR_ENFORCED=false

# System role model overrides (optional)
# Use format: provider:model-id (e.g., anthropic:claude-haiku-4-5-20251001, xai:grok-4.3)
MODEL_DAILY=anthropic:claude-haiku-4-5-20251001
MODEL_NEGOTIATION=anthropic:claude-haiku-4-5-20251001
MODEL_SYNTHESIS=anthropic:claude-sonnet-4-5-20250929

# Per-party model overrides (optional)
# Override specific party models (default: see model-config.ts)
# MODEL_PARTY_SPD=anthropic:claude-haiku-4-5-20251001
# MODEL_PARTY_CDU=anthropic:claude-haiku-4-5-20251001
# MODEL_PARTY_GRUENE=anthropic:claude-haiku-4-5-20251001
# MODEL_PARTY_FDP=anthropic:claude-haiku-4-5-20251001
# MODEL_PARTY_AFD=xai:grok-4.3
# MODEL_PARTY_LINKE=anthropic:claude-haiku-4-5-20251001

# ── Test mode ───────────────────────────────────────────────────────────
# Run full-term sims against free/local LLMs (zero cost, lower quality).
# When TEST_MODE is set, every party + role uses the same OpenAI-compatible
# endpoint and submitBatch() bypasses the Anthropic Batches API
# (parallel sync calls instead).
#
#   TEST_MODE=ollama   -> http://localhost:11434/v1, model gemma3:4b   (no key needed)
#   TEST_MODE=groq     -> https://api.groq.com/openai/v1, model llama-3.3-70b-versatile
#                         (set GROQ_API_KEY; free tier: 14.4K req/day, 30 RPM)
#   TEST_MODE=custom   -> requires TEST_BASE_URL + TEST_MODEL (+ TEST_API_KEY)
#
# Optional knobs (apply to any preset):
#   TEST_MODEL=<override>           # e.g. gemma3:12b, llama-3.1-8b-instant
#   TEST_BASE_URL=<override>
#   TEST_API_KEY=<override>
#   TEST_MODE_CONCURRENCY=4         # parallel in-flight calls per fan-out batch
#   GROQ_API_KEY=gsk_xxx            # used when TEST_MODE=groq
#
# TEST_MODE=ollama
