ANTHROPIC_API_KEY=sk-ant-xxxxx
XAI_API_KEY=xai-xxxx

# Database and API config (optional)
DATABASE_PATH=./data/simulation.db
USER_DATABASE_PATH=./data/users.db
API_PORT=3001

# System role model overrides (optional)
# Use format: provider:model-id (e.g., anthropic:claude-haiku-4-5-20251001, xai:grok-3-mini)
MODEL_DAILY=anthropic:claude-haiku-4-5-20251001
MODEL_NEGOTIATION=anthropic:claude-haiku-4-5-20251001
MODEL_SYNTHESIS=anthropic:claude-sonnet-4-5-20250929

# Per-party model overrides (optional)
# Override specific party models (default: see model-config.ts)
