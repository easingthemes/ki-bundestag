{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git status:*)",
      "Bash(git show:*)",
      "Bash(git blame:*)",
      "Bash(git branch:*)",
      "Bash(git remote:*)",
      "Bash(find:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(sort:*)",
      "Bash(uniq:*)",
      "Bash(awk:*)",
      "Bash(sed:*)",
      "Bash(cut:*)",
      "Bash(tr:*)",
      "Bash(diff:*)",
      "Bash(jq:*)",
      "Bash(pwd:*)",
      "Bash(which:*)",
      "Bash(env:*)",
      "Bash(printenv:*)",
      "Bash(ps:*)",
      "Bash(df:*)",
      "Bash(du:*)",
      "Bash(date:*)",
      "Bash(basename:*)",
      "Bash(dirname:*)",
      "Bash(echo:*)",
      "Bash(grep:*)",
      "Bash(ls:*)",
      "Bash(lsof:*)",
      "Bash(git stash:*)",
      "Bash(git fetch:*)",
      "Bash(git config:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(bash .claude/**)",
      "Bash(bash */.claude/**)",
      "mcp__ide__getDiagnostics",
      "mcp__chrome-devtools__take_screenshot",
      "mcp__chrome-devtools__navigate_page",
      "mcp__chrome-devtools__list_pages",
      "mcp__chrome-devtools__take_snapshot",
      "mcp__chrome-devtools__evaluate_script",
      "mcp__chrome-devtools__click",
      "mcp__chrome-devtools__hover",
      "mcp__chrome-devtools__emulate",
      "mcp__chrome-devtools__list_console_messages",
      "mcp__chrome-devtools__fill",
      "mcp__chrome-devtools__wait_for",
      "mcp__context7__resolve-library-id",
      "mcp__context7__query-docs",
      "WebSearch",
      "WebFetch(domain:docs.anthropic.com)",
      "WebFetch(domain:docs.x.ai)",
      "WebFetch(domain:ai-sdk.dev)",
      "WebFetch(domain:ui.shadcn.com)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:code.visualstudio.com)",
      "WebFetch(domain:codepen.io)",
      "WebFetch(domain:en.wikipedia.org)",
      "WebFetch(domain:www.bundestag.de)",
      "WebFetch(domain:www.bundeswahlleiterin.de)",
      "WebFetch(domain:www.tagesschau.de)",
      "WebFetch(domain:www.politico.eu)",
      "WebFetch(domain:www.highcharts.com)",
      "WebFetch(domain:www.timeanddate.com)"
    ]
  },
  "enableAllProjectMcpServers": true,
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "EnterPlanMode",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/pre-plan-remind.sh",
            "statusMessage": "Checking architecture docs..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/post-write-validate.sh",
            "statusMessage": "Checking conventions..."
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/post-impl-remind.sh",
            "statusMessage": "Checking docs..."
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/notification.sh",
            "statusMessage": "Sending notification..."
          }
        ]
      }
    ]
  },
    "env": {
    "COPILOT_CUSTOM_INSTRUCTIONS_DIRS": ".claude/rules"
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "enabledPlugins": {
    "dx-core@dx-aem-flow": true,
    "superpowers": true
  },
  "extraKnownMarketplaces": {
    "dx-aem-flow": {
      "source": {
        "source": "github",
        "repo": "easingthemes/dx-aem-flow"
      },
      "autoUpdate": true
    }
  }
}
